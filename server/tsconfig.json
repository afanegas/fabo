{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "..",
    "resolveJsonModule": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../shared/*"],
      "@client/*": ["../client/src/*"]
    }
  },
  "include": ["./**/*.ts", "../shared/**/*.ts", "../client/src/constants/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
