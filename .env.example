# Vorlage für die .env auf dem Server:  cp .env.example .env
# Die .env enthält persönliche Daten und wird NICHT ins Git-Repository übernommen.
#
# Werte mit einem $-Zeichen (Passwort-Hash) in 'einfache Anführungszeichen' setzen,
# sonst versucht Docker Compose, sie als Variablen aufzulösen.

# Domain, unter der Traefik das Spiel ausliefert (ohne https://)
CABO_DOMAIN=cabo.example.org

# Zugangsschutz (Traefik BasicAuth): Benutzer + Passwort-Hash
# Hash erzeugen, z. B.:  docker run --rm httpd:2.4-alpine htpasswd -nbB meinname 'MeinPasswort'
# Ausgabe (meinname:$2y$05$...) komplett in einfache Anführungszeichen setzen:
CABO_BASIC_AUTH='meinname:$2y$05$ErsetzenDurchDenEchtenHash'
